{
  "name": "casita-bakery",
  "version": "1.0.0",
  "description": "Arquitectura inicial para Casita Bakery Web",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:create": "psql -U postgres -f src/db/database.sql",
    "db:schema": "node src/db/runSqlFile.js schema",
    "db:seed": "node src/db/runSqlFile.js seed",
    "db:test": "node src/db/testConnection.js"
  },
  "keywords": [
    "bakery",
    "node",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
