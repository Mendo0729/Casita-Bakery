<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body>
    <main class="page-shell">
      <header class="page-header">
        <span class="page-kicker">Hecho en casa</span>
        <h1><%= title %></h1>
        <p><%= subtitle %></p>
        <% if (products && products.length > 0) { %>
          <span class="product-count"><%= products.length %> postres disponibles</span>
        <% } %>
      </header>

      <% if (!products || products.length === 0) { %>
        <p class="empty-message">Pronto tendremos postres disponibles.</p>
      <% } else { %>
        <section class="product-grid" aria-label="Catalogo de productos">
          <% products.forEach((product) => { %>
            <article class="product-card">
              <img class="product-image" src="<%= product.imagen_url %>" alt="<%= product.nombre %>">
              <div class="product-info">
                <span class="product-status">Disponible</span>
                <div class="product-copy">
                  <h2><%= product.nombre %></h2>
                  <p><%= product.descripcion %></p>
                </div>
                <strong class="product-price">$<%= Number(product.precio).toFixed(2) %></strong>
              </div>
            </article>
          <% }) %>
        </section>
      <% } %>
    </main>
    <script src="/js/main.js"></script>
  </body>
</html>
